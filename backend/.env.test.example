# Copia a backend/.env.test y ajusta los valores a los de tu .env de la raíz.
# `.env.test` está en .gitignore por la misma razón que `.env`: aunque sean
# credenciales de desarrollo, no se commitean.
#
# La base es aparte (`siappc_test`): test/helpers.ts la borra y la recrea
# desde schema.sql + seed.sql en cada corrida, así que nunca toca los datos de
# desarrollo.
#
# Antes de correr `npm test` hace falta que MariaDB y Redis estén alcanzables
# desde el host. El docker-compose.yml normal no publica el puerto de Redis, así
# que se levanta con el override:
#
#   docker compose -f docker-compose.yml -f docker-compose.test.yml up -d
#   cd backend && npm test

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siappc_test
# root porque las pruebas hacen CREATE/DROP DATABASE. Es el DB_ROOT_PASSWORD
# del .env de la raíz.
DB_USER=root
DB_PASSWORD=cambiame

PORT=3099
# Sin log de peticiones: si no, el resultado de la suite se pierde entre líneas.
LOG_LEVEL=silent
JWT_SECRET=solo-para-pruebas-no-usar-en-ningun-despliegue
ALLOWED_ORIGINS=http://localhost:5173

# Sin TLS: no hay broker en las pruebas y con MQTT_TLS=true el proceso exige la
# CA y se apaga al arrancar. buildApp() no conecta a MQTT — eso lo hace
# server.ts —, así que no hace falta broker.
MQTT_TLS=false

# La contraseña es el REDIS_PASSWORD del .env de la raíz.
REDIS_URL=redis://:cambiame@127.0.0.1:6379

# 1 s para que la prueba de expiración de caché no tarde diez.
SENSORS_CACHE_TTL=1
