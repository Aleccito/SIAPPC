# Copy to .env and fill in. .env is git-ignored and must stay that way.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siappc
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

PORT=3001
# openssl rand -hex 32
JWT_SECRET=

# Orígenes del navegador autorizados, separados por coma. Obligatoria: sin ella
# el proceso se apaga al arrancar. Nunca un comodín.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Broker MQTT. En Compose lo fija el docker-compose.yml de la raíz
# (`mosquitto:8883`); esto solo aplica si se corre el backend a mano.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=

# TLS. MQTT_CA_FILE apunta a la CA que firma el certificado del broker: en
# desarrollo, infra/mosquitto/certs/ca.crt (la genera
# infra/mosquitto/gen-certs.sh). Sin ella el proceso no arranca.
MQTT_CA_FILE=../infra/mosquitto/certs/ca.crt
# Solo si el broker exige mTLS (require_certificate true). Vacíos = sin
# certificado de cliente. Nunca apuntes esto a una clave dentro del repo.
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
# Escape para un broker heredado sin TLS. Déjalo en true.
MQTT_TLS=true

# Redis. En Compose lo fija el docker-compose.yml de la raíz
# (`redis://:<pass>@redis:6379`); esto solo aplica corriendo el backend a mano,
# y ese Redis no publica puerto al host. Vacío = el límite de peticiones cae al
# contador en memoria y la caché de /sensors/* queda desactivada; solo válido
# con una sola instancia.
REDIS_URL=
# Segundos que vive en caché una respuesta de /sensors/*. 0 desactiva la caché
# sin tocar el límite de peticiones.
SENSORS_CACHE_TTL=10

# Techo general de peticiones por minuto y por IP. Por defecto 100. Subirlo solo
# tiene sentido para medir con JMeter (ver Pruebas/README.md); en un despliegue
# real se deja como está.
RATE_LIMIT_MAX=100
