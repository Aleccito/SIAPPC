# Referencia de qué variables existen. NO sirve para arrancar: los valores
# reales los entrega Ing.Adrian, que manda el .env completo. Copiar este archivo y
# rellenarlo a mano no reproduce el entorno del equipo.
#
# El .env va en la raíz del repo, junto a docker-compose.yml, y está en
# .gitignore: nunca se commitea.

DB_NAME=thermotrace
DB_USER=cambiame
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame
# Puerto en el host para MariaDB; dentro de la red de Compose siempre es 3306.
DB_PORT=3306

BACKEND_PORT=3001
FRONTEND_PORT=8080

# Firma de los JWT. Sin esto el backend arranca y se apaga de inmediato.
JWT_SECRET=cambiame

# Orígenes del navegador autorizados, separados por coma. Obligatoria: el
# backend no arranca sin ella, y nunca se pone un comodín. 8080 es el tablero
# servido por nginx; 5173 es el frontend en modo desarrollo (`npm run dev`).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Broker MQTT. Ahora lo levanta el propio Compose (servicio `mosquitto`), así
# que no hay host que configurar: el backend siempre habla con `mosquitto:8883`
# por la red interna. El broker no acepta conexiones anónimas ni en texto
# plano, solo TLS.
#
# Con estas credenciales el contenedor crea su usuario al arrancar. La
# Raspberry debe usar exactamente las mismas en iot/.env.
MQTT_USER=siappc
MQTT_PASSWORD=cambiame

# Puerto TLS publicado en el host, por el que la Raspberry alcanza el broker.
MQTT_TLS_PORT=8883

# Los certificados NO son variables de entorno: se generan con
#   sh infra/mosquitto/gen-certs.sh
# y quedan en infra/mosquitto/certs/, que está en .gitignore. Son de
# desarrollo, autofirmados y regenerables; sin ellos el broker no arranca.
