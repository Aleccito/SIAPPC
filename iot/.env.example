# Copia a iot/.env y ajusta. El .env está en .gitignore y ahí se queda.

# Debe coincidir con `dispositivo.codigo` en la base de datos.
DEVICE_CODE=RPI-01

# El broker corre en la máquina del Compose, no en la Pi: pon aquí su IP o su
# nombre en la red. Solo escucha TLS, en 8883.
MQTT_HOST=localhost
MQTT_PORT=8883
# Las mismas credenciales que MQTT_USER/MQTT_PASSWORD del .env de la raíz: el
# broker no acepta conexiones anónimas.
MQTT_USER=siappc
MQTT_PASSWORD=

# CA que firma el certificado del broker. Se copia desde
# infra/mosquitto/certs/ca.crt (la genera infra/mosquitto/gen-certs.sh) a la
# ruta de abajo, que está en .gitignore. Solo el certificado público: la clave
# de la CA se queda en la máquina que la generó.
#
# Vacío = `iot/certs/ca.crt`, que es donde la deja el paso de arriba. Solo hace
# falta ponerlo si la CA vive en otro sitio, y entonces mejor con ruta absoluta.
MQTT_CA_FILE=
# Solo si el broker exige mTLS (require_certificate true).
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
# Escape para un broker heredado sin TLS. Déjalo en true.
MQTT_TLS=true

# Segundos entre publicaciones.
PUBLISH_INTERVAL=1
