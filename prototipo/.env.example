# Datos del prototipo (CONEXION-BACKEND.md, sección 4). Copiar a .env.local para cambiarlos.
# Sin este archivo el prototipo funciona solo, con datos simulados: es lo publicado en
# https://prototipo.melo-coton.uk.

# mock  = todo simulado en el navegador (por defecto)
# real  = todo va a /api, que Vite reenvía al backend en http://localhost:3001
# mixto = solo los grupos de VITE_API_REAL van al backend; el resto sigue simulado
VITE_API_MODE=mock

# Solo en modo mixto: grupos de rutas que van al backend, separados por comas. El grupo es el
# primer segmento de la ruta: auth, patients, historia, soap, dashboard, monitoring, sensors,
# notifications, reports, search, alerts.
# Ejemplo: VITE_API_REAL=auth,patients,dashboard
VITE_API_REAL=
