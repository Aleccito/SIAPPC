# Datos del prototipo en `npm run dev` (CONEXION-BACKEND.md, secciones 4 y 9). Copiar a .env.local para cambiarlos.
# Sin este archivo el prototipo funciona solo, con datos simulados. Lo publicado en https://prototipo.melo-coton.uk
# fija el modo al construir el contenedor (PROTOTIPO_API_MODE y PROTOTIPO_API_REAL en docker-compose.yml).

# mock  = todo simulado en el navegador (por defecto)
# real  = todo va a /api, que Vite reenvía al backend en http://localhost:3001
# mixto = solo lo de VITE_API_REAL va al backend; el resto sigue simulado
VITE_API_MODE=mock

# Solo en modo mixto: grupos o rutas que van al backend, separados por comas.
#   Un grupo es el primer segmento de la ruta: auth, patients, historia, soap, dashboard, monitoring, sensors,
#   notifications, reports, search, alerts, ai.
#   Una ruta más precisa deja fuera a sus vecinas: dashboard/assigned-patients va al backend, /dashboard/devices no.
# Lo del PR 1 de conexión: VITE_API_REAL=auth,dashboard/assigned-patients,sensors
VITE_API_REAL=
